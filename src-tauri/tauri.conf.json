{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "1.0.0",
  "identifier": "com.caffeinenotincluded.folio",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/make-dist.mjs",
    "beforeBuildCommand": "node scripts/make-dist.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Folio",
        "width": 1180,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Lifestyle",
    "shortDescription": "A private journal",
    "longDescription": "Folio is a private journal for your words, photos, drawings, recordings, places and moods, saved as files in a folder you choose.",
    "copyright": "Caffeine Not Included",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
